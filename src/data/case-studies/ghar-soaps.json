    {
      "tag": "h2",
      "text": "The Bigger Picture",
      "x": 324,
      "y": 7047,
      "w": 710,
      "h": 46,
      "size": "38px",
      "weight": "400",
      "color": "rgba(0, 0, 0, 0.75)",
